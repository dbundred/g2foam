// ECN Spray G2 constant-volume vessel domain (80 mm x 100 mm x 80 mm)
// Injector tip is located at (0, 0.0995, 0) injecting in the -y direction.

scale 0.001;

vertices
(
    (-80 0 -80)
    (-80 0  80)
    ( 80 0  80)
    ( 80 0 -80)
    (-80 100 -80)
    (-80 100  80)
    ( 80 100  80)
    ( 80 100 -80)
);

blocks
(
    // Adjust (Nx Nz Ny) grid resolution below as needed
    // 1 mm uniform resolution across 160 mm x 160 mm x 100 mm domain (2,560,000 cells)
    hex (0 1 2 3 4 5 6 7) (160 160 100) simpleGrading (1 1 1)
);

edges
(
);

patches
(
    wall walls
    (
        (2 6 5 1)
        (0 4 7 3)
        (0 1 5 4)
        (4 5 6 7)
        (7 6 2 3)
        (3 2 1 0)
    )
);

mergePatchPairs
(
);

