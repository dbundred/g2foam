FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// ECN Spray G2 Ambient Pressure: 50 kPa (0.5 bar) -> flash-boiling condition
// ( yields ambient N2 density ~ 0.5 kg/m^3 at 333 K )

dimensions          [1 -1 -2 0 0 0 0];

internalField       uniform 50000;

boundaryField
{
    walls
    {
        type            zeroGradient;
    }
}

